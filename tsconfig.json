{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "moduleResolution": "node",
    "baseUrl": ".",                          
    "paths": {                              
      "@generated/*": ["generated/*"],
    },
    "typeRoots": ["./node_modules/@types", "./generated", "./generated/prisma"]
  },
  "include": ["./**/*", "./types", "generated/**/*"],
  "exclude": ["node_modules", "dist"]
}