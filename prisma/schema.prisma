generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model comments {
  id      Int  @id @default(autoincrement())
  content String @db.VarChar(255)
  user_id Int
  post_id Int
  users   users   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk8omq0tc18jd43bu5tjh6jvraq")
  posts   posts   @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkh4c7lvsc298whoyd4w9ta25cr")
}

model posts {
  id       Int     @id @default(autoincrement())
  content  String    @db.VarChar(255)
  title    String    @db.VarChar(255)
  user_id  Int
  comments comments[] 
  users    users      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk5lidm6cqbc7u4xhqpxm898qme")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model users {
  id       Int     @id @default(autoincrement())
  email    String     @unique@db.VarChar(255)
  nickname String     @unique@db.VarChar(255)
  password String     @db.VarChar(255)
  profilePic String?
  comments comments[]
  posts    posts[]
}
